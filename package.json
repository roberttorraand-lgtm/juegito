{
  "name": "la-distorsion-externa",
  "version": "0.1.0",
  "description": "Fan game no oficial - Episodio 1: La Distorsión Externa",
  "main": "main.js",
  "author": "roberttorraand-lgtm",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never",
    "cap:init": "npx cap init \"La Distorsion Externa\" com.juegito.distorsionexterna --web-dir game",
    "cap:android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "build": {
    "appId": "com.juegito.distorsionexterna",
    "productName": "La Distorsion Externa",
    "files": [
      "main.js",
      "game/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "La-Distorsion-Externa-${version}.exe"
    }
  },
  "devDependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/preferences": "^7.0.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  }
}
